{
  "name": "portfolio",
  "version": "1.0.0",
  "private": false,
  "description": "Portfolio",
  "author": {
    "name": "cletqui"
  },
  "repository": {
    "type": "github",
    "url": "https://github.com/cletqui/portfolio"
  },
  "keywords": [
    "portfolio"
  ],
  "homepage": "https://www.cybai.re/",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cletqui/portfolio/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "node_modules/.bin/tailwindcss -i src/styles.css -o public/styles.css && vite",
    "watch:css": "node_modules/.bin/tailwindcss -i src/styles.css -o public/styles.css --watch",
    "build:css": "node_modules/.bin/tailwindcss -i src/styles.css -o public/styles.css --minify",
    "build": "vite build --mode bundle && vite build",
    "preview": "wrangler pages dev dist",
    "deploy": "$npm_execpath run build && wrangler pages deploy dist",
    "log": "wrangler pages deployment tail"
  },
  "dependencies": {
    "hono": "^4.12.23"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260706.1",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-cloudflare-pages": "^0.4.3",
    "@hono/vite-dev-server": "^0.25.3",
    "@tailwindcss/cli": "^4.3.0",
    "lucide-static": "^1.17.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.16",
    "wrangler": "^4.98.0"
  }
}
