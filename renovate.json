{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Paris",
  "schedule": [
    "before 6am on monday"
  ],
  "commitMessagePrefix": "chore(deps):",
  "commitMessageLowerCase": "auto",
  "semanticCommits": "disabled",
  "dependencyDashboard": true,
  "osvVulnerabilityAlerts": true,
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 5,
  "lockFileMaintenance": {
    "enabled": false
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "OSV_SCANNER_VERSION: \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "google/osv-scanner",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "SEMGREP_VERSION: \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "semgrep",
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "description": "Dev dependencies, minor and patch",
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "dev dependencies"
    },
    {
      "description": "Production dependencies, minor and patch",
      "matchDepTypes": [
        "dependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "production dependencies"
    },
    {
      "description": "GitHub Actions",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "groupName": "security tooling"
    }
  ]
}
